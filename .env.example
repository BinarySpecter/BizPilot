# BizPilot AI environment variables
# Copy to .env.local for local development. NEVER commit .env* files.

# ---- AI reasoning layer (Gemini — OpenAI-compatible API) -------------------
# Create a free Gemini API key at https://aistudio.google.com/apikey, then set
# it here. The key is read server-side only (analytics/llm.py) and must never
# be shipped to the browser or exposed via NEXT_PUBLIC_*.
#
# Leave LLM_API_KEY empty to run the full analytics dashboard without AI chat;
# Ask Your Business then returns deterministic, evidence-based answers from
# the computed analytics instead. The provider is OpenAI-compatible, so any
# compatible endpoint (e.g. Groq) remains usable by overriding the values
# below.
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.5-flash-lite

# ---- Local Python API (optional override) ---------------------------------
# Only used by the Next.js dev/prod proxy when not running on Vercel.
# PYTHON_API_URL=http://127.0.0.1:8787